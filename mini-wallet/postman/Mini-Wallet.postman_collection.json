              "path": [
                "api",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"initialBalance\": 10\n}"
            }
          }
        },
        {
          "name": "Negative initial balance (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
