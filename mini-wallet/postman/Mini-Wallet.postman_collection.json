{
  "info": {
    "name": "Mini Wallet API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "1. Create wallet - Rahul",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\",\n  \"email\": \"rahul@example.com\",\n  \"initialBalance\": 1000.0\n}"
            }
          }
        },
        {
          "name": "2. Create wallet - Priya",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya\",\n  \"email\": \"priya@example.com\",\n  \"initialBalance\": 500.0\n}"
            }
          }
        },
        {
          "name": "3. Deposit into wallet 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/1/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "1",
                "deposit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.0\n}"
            }
          }
        },
        {
          "name": "4. Transfer 1 -> 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": 1,\n  \"toWalletId\": 2,\n  \"amount\": 300.0\n}"
            }
          }
        },
        {
          "name": "5. Get wallet 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "1"
              ]
            }
          }
        },
        {
          "name": "6. Get wallet 2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "2"
              ]
            }
          }
        },
        {
          "name": "7. Transactions of wallet 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "1",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "8. Transactions of wallet 2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/2/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "2",
                "transactions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Failure scenarios",
      "item": [
        {
          "name": "Duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul 2\",\n  \"email\": \"rahul@example.com\",\n  \"initialBalance\": 10\n}"
            }
          }
        },
        {
          "name": "Invalid email (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
