              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": 2,\n  \"toWalletId\": 1,\n  \"amount\": 999999\n}"
            }
          }
        },
        {
          "name": "Transfer to same wallet (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": 1,\n  \"toWalletId\": 1,\n  \"amount\": 10\n}"
            }
          }
        },
        {
          "name": "Transfer zero amount (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": 1,\n  \"toWalletId\": 2,\n  \"amount\": 0\n}"
            }
          }
        },
        {
          "name": "Transfer to missing wallet (404, no money lost)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": 1,\n  \"toWalletId\": 9999,\n  \"amount\": 10\n}"
            }
          }
        },
        {
          "name": "Get missing wallet (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "9999"
              ]
            }
          }
        },
        {
          "name": "Transactions of missing wallet (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/9999/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
