            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"y@example.com\"\n}"
            }
          }
        },
        {
          "name": "Deposit zero (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/1/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "1",
                "deposit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 0\n}"
            }
          }
        },
        {
          "name": "Deposit negative (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/1/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "1",
                "deposit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -10\n}"
            }
          }
        },
        {
          "name": "Deposit to missing wallet (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/9999/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "9999",
                "deposit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10\n}"
            }
          }
        },
        {
          "name": "Transfer insufficient balance (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
